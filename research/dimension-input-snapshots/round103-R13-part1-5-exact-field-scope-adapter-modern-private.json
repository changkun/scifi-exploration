      "original_proposed_field": {
        "proposed_value": "另一复活选例在死者去世数百年后；不覆盖全卷时代。",
        "basis": {
          "issue": "本集评论举出两类时间与生命的困境：恋人接触时停止时间，进而渴求不衰老；另一个死者则以曾被计算机记录的人格，在数百年后的人造身体中复活。这里以这些明确选例考察亲密关系怎样受永生欲望改变，以及人格重建是否足以保留一个人的连续性。",
          "facet_bases": [
            "评论描述两名恋人接触时自身与周围时间停止，随后形成对不老的强烈渴求。",
            "评论的另一个选例让长期死去者通过早先电脑保存的人格，在数百年后的人造身体中重生。"
          ]
        },
