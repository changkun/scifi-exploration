      "original_A": {
        "id": "Q135094111",
        "identity": {
          "title": "Manifest Destiny",
          "author": "Barry B. Longyear"
        },
        "fields": {
          "topics": [
            "殖民与他者",
            "资本与劳动",
            "知识与认识"
          ],
          "issue": "本合集《Savage Planet》中的人类教师受采矿公司雇用，用赞美人类征服的教材教育异星学生；了解当地生命后，他转而帮助学生为自己抗争。教育既可能包装资源掠夺的合理性，也能够通过接触被统治者而改变教师对自身工作的理解。",
          "issue_facets": [
            {
              "label": "企业教材与殖民知识",
              "question": "采矿公司编写的历史教材，怎样把对原住民的控制描绘成文明收益？",
              "basis": "摘要明确教师使用雇用他的矿业公司编写教材，宣扬Manifest Destiny和人类殖民好处。"
            },
            {
              "label": "教学关系与立场改变",
              "question": "教师对学生生活的理解，何时会使他拒绝雇主规定的教育目标？",
              "basis": "摘要写Michael在了解异星生活后选择帮助他们为自己抗争。"
            }
          ]
