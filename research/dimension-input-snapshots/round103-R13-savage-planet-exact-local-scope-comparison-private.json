        },
        "fields": {
          "topics": [
            "性别与亲密",
            "知识与认识",
            "生命与人类定义"
          ],
          "issue": "Armath发现另一男性的尸体，却因接近男性的文化禁忌而难以认出死亡；这种禁忌又与争斗取得、失去性别位置的身体变化相连。判断现实受到制度化身体规则限制，生理设定也不能替强制等级提供天然正当性。",
          "issue_facets": [
            {
              "label": "接近禁忌与事实识别",
              "question": "禁止接近同类的规则，怎样妨碍判断眼前生命是否需要帮助？",
              "basis": "已识别本篇的论坛答复明确Armath发现尸体，但男性不得近距离相接的禁忌阻碍辨认死亡。"
            },
            {
              "label": "性别变化与权力竞争",
              "question": "通过争斗取得性别位置，为什么不能把胜负直接等同于社会价值？",
              "basis": "答复说明生命先为女性，争夺优势成为男性，失败者回变女性，近距接近被视为支配挑战。"
            }
          ]
        },
