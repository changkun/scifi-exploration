    {
      "id": "Q133800871",
      "identity": {
        "title": "Mort à l'étouffée",
        "author": "Jean-Pierre Hubert"
      },
      "fields": {
        "topics": [
          "资本与劳动",
          "权力与制度",
          "生存与风险"
        ],
        "issue": "评论明确将本作描绘为漂浮在空间中的封闭世界，生活其中的人彼此撕扯，并把这种封闭理解为资本主义制度的困局。仅据这一设定，逃离冲突不仅是寻找物理出口的问题，也涉及共同生活为何转为互相伤害；这里不继承同页另一故事的追踪器或逃亡情节。",
        "issue_facets": [
          {
            "label": "封闭系统与结构性冲突",
            "question": "生活世界被封闭后，成员的互相伤害怎样与制度困局联系？",
            "basis": "本作具名评论把封闭漂浮世界、彼此撕扯与资本主义体系的封闭并置；不追加具体阶层、资源或统治者。"
          },
          {
            "label": "共同生存与互相伤害",
            "question": "同处一个难以脱离的世界，为什么未必产生共同生存的协作？",
            "basis": "同一具名评论明示人在封闭世界内互相撕扯；没有材料交代解决方案，问题只由这一冲突提出。"
          }
        ]
      },
      "field_notes": {
        "topics": "只据本身份有限明确前提人工选择，不按作者/系列传播；待独立核对。",
        "issue": "有限实际检索返回的作品前提＋原创文学解释；原作全文未读，评论者判断和剧情事实分开。",
        "issue_facets": "两项具体问题与所读设定依据；相邻篇/长篇扩写/其他卷不继承。"
      },
