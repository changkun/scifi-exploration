    {
      "id": "Q131518070",
      "identity": {
        "title": "Soul of the City",
        "author": "邁克爾·F·弗林"
      },
      "fields": {
        "topics": [
          "技术与责任",
          "权力与制度"
        ],
        "issue": "对非法涂鸦的技术清除战，促使创作者把画作设计成随表层剥除而有计划变形的作品。仅据该单篇的社区识别简介，控制公共表面的技术反而成为表达更新的条件，清除与创作的竞争使谁能定义城市可见形象成为问题。",
        "issue_facets": [
          {
            "label": "清除技术与创作适应",
            "question": "清除一层图像为什么可能成为另一幅图像出现的条件？",
            "basis": "社区回答把本篇描述为针对非法涂鸦的技术战，并具体说作品在层层剥除中按计划改变。"
          },
          {
            "label": "公共表面的表达权",
            "question": "技术管理城市表面时，如何界定未经许可的表达？",
            "basis": "采用材料明确冲突双方为清除技术与outlaw graffiti artists；只据该前提提出治理问题，不推法律细则或结局。"
          }
        ]
      },
      "field_notes": {
        "topics": "依据明确采用的本作局部或前提归纳；文学解释待独立核对。",
        "issue": "实际搜索返回中该标题专属项目：清除非法涂鸦的技术战导致画作随表层逐渐剥除而有计划变形；识别措辞为almost certainly，未核其外引资料。只采用该项目。；真实返回仅用于识别边界：回答者以同名单篇及Analog1989年2月、1991收录本定位，提问者确认并购得书；不作为独立剧情核验。；实际返回的作者博客明确同名1989单篇属于Nanotech Chronicles、Charlie Singer出现且在SingerLabs成名前；此采用段不证明涂鸦细节，也未打开故事全文。",
        "issue_facets": "只解释采用材料的具体依据，不补相邻篇、未述机制或结局。"
      },
