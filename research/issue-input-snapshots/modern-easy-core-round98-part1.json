    {
      "id": "Q131471765",
      "identity": {
        "title": "Surrender",
        "author": "卢修斯·谢泼德"
      },
      "fields": {
        "topics": [
          "技术与责任",
          "殖民与他者",
          "知识与认识"
        ],
        "issue": "战地记者Carl已看惯多国战争中的尸体和受害者，较年轻的同行Paul却催他前往危地马拉Petén雨林边的棚户区调查异常传闻。仅据评论所明确摘述的开头，经验既能帮助识别暴力，也可能把不同受害者压成重复景象；继续调查与麻木退让之间形成新闻见证的张力。",
        "issue_facets": [
          {
            "label": "战争经验与见证麻木",
            "question": "熟悉战争会让记者更敏锐，还是更容易把不同的人视作重复伤亡？",
            "basis": "评论在SURRENDER独立标题下引用Carl见惯战争尸体的开头，并明确他经历过多国战区。"
          },
          {
            "label": "传闻与继续调查",
            "question": "面对异常传闻，经验老到的旁观者还有什么调查责任？",
            "basis": "评论明确年轻十岁的记者Paul DeVries要求Carl前往Petén雨林边棚户区，因那里传出奇怪事件；未补异常机制或后续遭遇。"
          }
        ]
      },
      "field_notes": {
