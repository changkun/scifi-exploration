    {
      "id": "Q131461517",
      "identity": {
        "title": "Marîd Changes His Mind",
        "author": "George Alec Effinger"
      },
      "fields": {
        "topics": [
          "性别与亲密",
          "主体与意识"
        ],
        "issue": "Marîd带朋友突然拜访母亲，重逢却被他的叙述组织为对病容、化妆和身体缺点的细看。仅据编辑提供的这一授权片段，亲缘接近与关怀并不自然等同，观看和描述也可能把母亲的处境压缩为儿子的评判。",
        "issue_facets": [
          {
            "label": "亲缘关系中的观看",
            "question": "带朋友重逢时，谁拥有描述家庭成员的权力？",
            "basis": "片段明确Marîd未预告便与Half-Hajj到母亲住处；叙述随即细看母亲的外貌和装扮。"
          },
          {
            "label": "疾病与外貌判断",
            "question": "对病容的评价会怎样遮蔽被看者的生活处境？",
            "basis": "母亲说自己病着躺在床上，随后第一人称叙述持续评价化妆、头发和身体；不补母亲反应或结局。"
          }
        ]
      },
      "field_notes": {
        "topics": "依据明确采用的本作局部或前提归纳；文学解释待独立核对。",
        "issue": "实际直接打开返回L24–29及L48：编辑将单篇明确对应长篇开头两章，并提供Marîd与Half-Hajj突然拜访Angel Monroe的授权原文局部；母亲说自己病着，叙述评价其外貌。页面另谈Plastic Pasha的段落未采用；不是完整单篇或两章读取。",
        "issue_facets": "只解释采用材料的具体依据，不补相邻篇、未述机制或结局。"
      },
