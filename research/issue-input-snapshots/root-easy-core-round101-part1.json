    {
      "id": "Q131471918",
      "identity": {
        "title": "In Whose Name Do We Seek the Quark?",
        "author": "Thomas R. Dulski"
      },
      "fields": {
        "topics": [
          "知识与认识",
          "信仰与意义"
        ],
        "issue": "在In Whose Name Do We Seek the Quark?的局部教堂场景中，理性论证、宗教宽恕与对脆弱者的关切怎样相互牵制？",
        "issue_facets": [
          {
            "label": "论证与信仰回应",
            "question": "面对无法仅靠理性论证消除的疑问，人们会怎样寻求另一种回答？",
            "basis": "返回的具名原篇片段在理性可证性的讨论后提出题名中的问题，随后呈现教堂中的神职人员与当事人；只分析这一局部并置，不补未见的科学实验或未知对象身份。"
          },
          {
            "label": "困惑者与宽恕",
            "question": "理解一个困惑、孤独的人，是否需要把道德判断与关怀区分开？",
            "basis": "局部场景称Hilga是困惑孤独的女人，神父回应宽恕；叙述者关切Judy是否受到伤害并拥抱她。不推断她们未述的亲属关系或整篇结局。"
          }
        ]
