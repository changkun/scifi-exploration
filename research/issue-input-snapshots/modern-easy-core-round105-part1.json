    {
      "id": "Q135093040",
      "identity": {
        "title": "After the Fall",
        "author": "作者未知"
      },
      "fields": {
        "topics": [
          "生存与风险",
          "文明与历史"
        ],
        "issue": "After the Fall的封面文案把整颗地球及居民被毁灭十五次作为这本选集的组织前提，并以轻快的讽刺口吻招徕读者。这里分析的是选集如何把不可逆的共同终局变成可反复观看的灾难想象；不同篇目的毁灭机制、人物和结局不能因此被当作同一个故事。",
        "issue_facets": [
          {
            "label": "共同终局与灾难尺度",
            "question": "当文案把局部灾难升级为整颗地球毁灭，个体行动还能如何被理解为有意义？",
            "basis": "Black Gate实际引用本选集封面文案：地球与居民被毁灭十五次；只采用文案呈现的全局终局尺度，不说明各篇具体行动。"
          },
          {
            "label": "灾难的讽刺消费",
            "question": "用轻快和娱乐化口吻呈现全人类毁灭，会怎样改变读者与灾难的距离？",
            "basis": "同一封面引用用offbeat、upbeat与乐趣描述Armageddon；本项是对选集包装方式的文学解释，不认定每一成员都采用同一种叙述视角。"
          }
        ]
