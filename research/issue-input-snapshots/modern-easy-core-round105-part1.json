    {
      "id": "Q134581971",
      "identity": {
        "title": "Deux souris pour un Concorde",
        "author": "Jean-Louis Le May"
      },
      "fields": {
        "topics": [
          "权力与制度",
          "文明与历史",
          "性别与亲密"
        ],
        "issue": "本卷书介写Julie、Noelle、Jacques、Michel两对青年，怀着对较少污秽的未来的共同信念，与现有权力的现实主义和犬儒态度相抗。只据这项前提，私人关系中的信任也成为共同改变世界的动力；愿为信念承担极端代价，不等于已经发生牺牲或已证明理想可实现。",
        "issue_facets": [
          {
            "label": "青年理想与既有权力",
            "question": "青年对共同未来的信念怎样面对掌权者以现实主义为名的犬儒态度？",
            "basis": "本卷明确书介把新青年的世界主义与现有权力的现实主义犬儒并置；不借同系列其他卷说明其政治制度。"
          },
          {
            "label": "亲密关系与共同风险",
            "question": "两对伴侣的共同信念如何把私人关系与公共行动的风险连在一起？",
            "basis": "同一书介点名四人、两对情侣及对较好未来的同一信念，并说有走向殉难的意愿；不确认殉难实际发生。"
          }
        ]
      },
      "field_notes": {
        "topics": "依本身份有限具体前提人工选择，保留待独立核验，不按作者或体裁传播。",
        "issue": "仅所列source_evidence准确范围；若analysis_basis为已有知识则材料只证成员身份，剧情不是本次读取。",
        "issue_facets": "两项原创文学解释，未读原作全文；未述机制、结局和其他篇目不追加。"
      },
