    {
      "id": "Q135209421",
      "identity": {
        "title": "How Meersh the Bedeviler Lost His Toes",
        "author": "Gregory Frost"
      },
      "fields": {
        "topics": [
          "主体与意识",
          "知识与认识"
        ],
        "issue": "Meersh这个诡计者收集各种游戏，甚至不知道部分游戏如何玩；赶路经过亡者世界时，他仍忍不住停下看鬼魂下棋。游戏欲望因此既提供探索的动力，也夺走他决定何时停止、何时行动的能力。",
        "issue_facets": [
          {
            "label": "欲望与自主",
            "question": "当游戏吸引压过眼前任务时，行动还由谁决定？",
            "basis": "作者明确说Meersh迷恋收集游戏，即使需要赶路也被亡者的棋局吸引。"
          },
          {
            "label": "拥有与理解",
            "question": "收藏一项游戏是否等于理解它？",
            "basis": "Meersh收集所有类型的游戏，却不知道其中一些如何玩。"
          }
        ]
      },
      "field_notes": {
        "topics": "依据下列明确本作/本卷/已确认成员的检索返回归纳；文学解释待独立核对。",
