    {
      "id": "Q3208001",
      "identity": {
        "title": "La créature",
        "author": "作者未知"
      },
      "fields": {
        "topics": [
          "生命与人类定义",
          "知识与认识",
          "权力与制度"
        ],
        "issue": "Marc和Kim曾遭神秘Mantrisse吞没村庄，而Alexa和Driss又依靠同一生物提供的药剂保持百年青春；他们所在的Aldebaran殖民地还受到专制警察追捕。生命延长的希望与生物灾难来自同一未知存在，理解它也牵涉人能否摆脱政治控制。",
        "issue_facets": [
          {
            "label": "救赎与危险同源",
            "question": "带来青春的生命体同时毁坏家园，人如何判断依赖的代价？",
            "basis": "本卷简介并列村庄被Mantrisse黏液吞没及另两人接受其青春药剂。"
          },
          {
            "label": "控制中的求知",
            "question": "政治追捕会怎样限制人追索未知生物的真相？",
            "basis": "本卷转述简介明确殖民地由专制政权掌控，主人公被警察追踪。"
          }
        ]
      },
      "field_notes": {
