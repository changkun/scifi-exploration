    {
      "id": "Q131461669",
      "identity": {
        "title": "Izzy and the Father of Terror",
        "author": "Eliot Fintushel"
      },
      "fields": {
        "topics": [
          "主体与意识",
          "知识与认识"
        ],
        "issue": "开篇的Mel在新墨西哥遇见Shaman后，叙述自己无法区分身体与世界、自我与他人；他试图凭家人的名字和面孔重新确认自己，却连母亲的脸也想不起。这里的冲突是主体边界瓦解以后，个人记忆能否继续作为现实和身份的锚点。",
        "issue_facets": [
          {
            "label": "自我边界",
            "question": "无法区分自我与外界时，经验还如何归属于一个人？",
            "basis": "开篇第1节明确Mel感到心灵被刺穿，自己、身体、他人与世界的界线消失。"
          },
          {
            "label": "记忆的锚点",
            "question": "家人关系的记忆是否足以证明身份与现实？",
            "basis": "开篇第2节Mel向Joshua tree说起纽约的母亲及兄妹，却无法回忆母亲面孔。"
