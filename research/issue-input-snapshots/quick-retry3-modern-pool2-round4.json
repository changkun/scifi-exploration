    {
      "id": "Q132189042",
      "identity": {
        "title": "Cinta Yang Berpikir",
        "author": "Ellen Kristi"
      },
      "fields": {
        "topics": [
          "权力与制度",
          "知识与认识",
          "性别与亲密"
        ],
        "issue": "《Cinta Yang Berpikir》的2016修订版介绍明确它是Charlotte Mason家庭教育手册，主张对孩子的爱还需要知识与反思。它把父母权威与儿童自由的平衡，以及借习惯训练和优质读物培育品格的问题并置；这里分析的是教育论述的具体前提，不将手册描述为科幻故事。",
        "issue_facets": [
          {
            "label": "父母权威与儿童自由",
            "question": "爱与保护怎样避免把养育变成对儿童自主性的全面支配？",
            "basis": "CMIndonesia修订版书介明确提出父母权威与儿童自由的平衡，并讨论儿童本质与父母角色。"
          },
          {
            "label": "反思之爱与学习环境",
            "question": "家庭应怎样把爱、知识、习惯和读物组合成教育条件？",
            "basis": "同一修订版简介明确爱要补以知识反思，并用习惯训练、living books和丰富且友好的课程建设品格；未阅读手册正文。"
          }
        ]
      },
      "field_notes": {
        "topics": "实际限定资料的文学解释，待独立核对。",
        "issue": "一次实际新查询及一次CMIndonesia准确书介L73—96直接读取。明示所读是2016修订版，源2012年份保持；只一般教育主张和书介列出的具体问题，不把三部分/各章细节倒推2012原版，也不将教育手册误作小说或科学预测。",
        "issue_facets": "原创具体问题；只取明示前提或明确评论视角，不声称作者定论/正文完整组织。"
      },
