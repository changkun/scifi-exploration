      "old_value": [
        {
          "label": "犯罪解释与心智改造",
          "question": "把犯罪倾向定位为可用药物消除的神经元，会如何改变责任与治疗的边界？",
          "basis": "具名读者评论称胜利后可用特殊药丸消除脑中neurony zbrodni、治疗专制倾向；这里只解释评论所述方案，不确认实际执行、疗效或现实科学。"
        },
        {
          "label": "安全秩序与青年行动",
          "question": "青年维护和平的组织如何界定其对敌人及社会的行动权限？",
          "basis": "同一评论写海底势力谋消灭人类并控制全球，Sursum Corda青年为联合地球共和国和平发展而战；未核结局，也不把评论者的政治评价直接当作者意图。"
        }
      ],
      "new_value": [
        {
          "label": "共同生存与统治诉求",
          "question": "以掌控全球为目的、威胁消灭人类的计划，如何使共同生存与权力占有发生冲突？",
          "basis": "具名Jarosław Loretz评论明确海底势力计划消灭全人类并把全球置于自己统治；只采用该计划，不确认其执行或最后胜败。"
        },
        {
          "label": "青年集体与和平防御",
          "question": "青年为和平发展而共同对抗统治计划时，行动正当性如何与所维护的社会目标相联系？",
          "basis": "同一评论明确Sursum Corda青年组织勇于对抗该计划、为联合地球共和国和平发展行动；未核结局，不把评论者的政治评价当作者意图。"
