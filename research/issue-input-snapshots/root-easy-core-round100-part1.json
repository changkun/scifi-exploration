    {
      "id": "Q131472010",
      "identity": {
        "title": "Foreign Skins",
        "author": "Tanith Lee"
      },
      "fields": {
        "topics": [
          "殖民与他者",
          "照护与依赖"
        ],
        "issue": "在Foreign Skins的早期家庭片段中，殖民家庭的偏见与成人对事实的选择性坦白，怎样影响儿童接受另一文化的教育？",
        "issue_facets": [
          {
            "label": "对儿童坦白死亡与成人遮掩",
            "question": "家长选择让儿童知道什么时，事实教育与成人的控制如何交织？",
            "basis": "片段中父亲要求八岁David接受死亡是日常事实；母亲因儿童正在听而打断谈话。只解释此场景，不推断整个故事的结局。"
          },
          {
            "label": "跨文化照护中的排斥",
            "question": "雇主对被雇照护者的偏见会怎样限制儿童的文化学习？",
            "basis": "Evelyn把印度照护者Agnini看作威胁并避开她，而David因听懂她的印地语问候而高兴，随后听她用英语讲故事。"
          }
        ]
      },
      "field_notes": {
        "topics": "依据实际局部材料提出的文学解释，待独立核对。",
        "issue": "实际查询返回Tamastara中明确Foreign Skins标题下的早期家庭与Agnini/David片段；只读返回局部原文，没有读完整中篇。",
        "issue_facets": "只对应采用的具名篇、局部片段或明确标注的合集书介，不补未述故事、版本或结局。"
