    {
      "id": "Q134723280",
      "identity": {
        "title": "After-Images",
        "author": "Malcolm Edwards"
      },
      "fields": {
        "topics": [
          "生存与风险",
          "时间与因果"
        ],
        "issue": "After-Images的具名读者概述中，核打击后的时间骤缓把死亡从瞬间冲击变成逐渐逼近的过程，人如何面对被延长的灾难？",
        "issue_facets": [
          {
            "label": "延迟到来的核灾难",
            "question": "灾难传播变得极慢，是否就能解除已发生的破坏所带来的威胁？",
            "basis": "读者专门点名本篇：三重核打击产生时间减慢约百万倍的区域，光、热和辐射前沿逐步逼近少数居民。只采用这一前提，不补最终逃离、人物选择或技术原因。"
          },
          {
            "label": "不同步的危险经验",
            "question": "当区域中的时间与外部灾难进程不同步时，人如何认识自身仍处于危险之中？",
            "basis": "同一具名概述把时间减慢区域和持续逼近的光热辐射并置；这是对有限前提的文学解释，未确认居民掌握的仪器、具体持续天数或完整结局。"
          }
        ]
      },
      "field_notes": {
        "topics": "依据实际具名局部材料提出的文学解释，待独立核对。",
