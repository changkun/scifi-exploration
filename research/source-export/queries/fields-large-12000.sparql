 {
 { VALUES ?prop { wdt:P50 wdt:P2093 wdt:P577 wdt:P407 wdt:P31 wdt:P136 wdt:P1476 wdt:P648 }
 ?work ?prop ?value . BIND(STRAFTER(STR(?prop), "/direct/") AS ?field) }
