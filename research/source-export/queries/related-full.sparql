SELECT ?entity ?label WHERE {
 { SELECT DISTINCT ?entity WHERE {
   ?work wdt:P136/wdt:P279* wd:Q24925 .
   ?work wdt:P31/wdt:P279* wd:Q7725634 .
   VALUES ?prop { wdt:P50 wdt:P407 wdt:P31 wdt:P136 }
   ?work ?prop ?entity . FILTER(ISIRI(?entity))
 } }
 ?entity rdfs:label ?label . FILTER(LANG(?label) IN ("zh","zh-hans","en"))
}
