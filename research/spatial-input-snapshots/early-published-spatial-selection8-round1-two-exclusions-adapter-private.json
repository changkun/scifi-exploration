          "fields": {
            "topics": [
              "生命与人类定义",
              "资本与劳动",
              "生存与风险"
            ],
            "issue": "在辐射侵蚀地表的世界，逃出活体迷宫的人仍要面对捕捉异常生命供实验和药业使用的猎人。畸变身体既承受危险又成为资源，作品将生存空间与身体商品化连成同一困境。",
            "issue_facets": [
              {
                "label": "异常身体作为实验资源",
                "question": "变异者被视为优良实验对象时，谁承认其自身生存利益？",
                "basis": "转述书介明确捕猎者为基因工程实验室及制药工业取得terato-poulpeux试验对象。"
              },
              {
                "label": "逃生与生态敌意",
                "question": "离开迷宫是否真正摆脱威胁，还是进入另一层生存筛选？",
                "basis": "Ampelopsis为巨大活体敌意迷宫，出口通向分层城市，而外围垃圾场还有寻找食物的下层变异者。"
              }
            ]
          },
          "field_notes": {
            "topics": "根据实际读取的本作有限简介作人工分类，待独立核对。",
