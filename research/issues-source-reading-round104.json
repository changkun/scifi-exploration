    {
      "id": "Q125913273",
      "identity": {
        "title": "Neurony zbrodni",
        "author": "Lucyna Anastazja Penciak-Radzymińska"
      },
      "fields": {
        "topics": [
          "权力与制度",
          "生存与风险"
        ],
        "issue": "Neurony zbrodni的具名评论描述海底势力计划消灭人类并控制地球，青年组织Sursum Corda为联合地球共和国的和平发展与之对抗。以消灭他人为手段的全球统治计划，与青年维护共同生存的集体行动形成冲突；保护和平如何避免被统治诉求取代，是这一已述对抗可提出的问题。",
        "issue_facets": [
          {
            "label": "共同生存与统治诉求",
            "question": "以掌控全球为目的、威胁消灭人类的计划，如何使共同生存与权力占有发生冲突？",
            "basis": "具名Jarosław Loretz评论明确海底势力计划消灭全人类并把全球置于自己统治；只采用该计划，不确认其执行或最后胜败。"
          },
          {
            "label": "青年集体与和平防御",
            "question": "青年为和平发展而共同对抗统治计划时，行动正当性如何与所维护的社会目标相联系？",
            "basis": "同一评论明确Sursum Corda青年组织勇于对抗该计划、为联合地球共和国和平发展行动；未核结局，不把评论者的政治评价当作者意图。"
          }
        ]
      },
      "field_notes": {
        "topics": "依本身份确切有限材料人工选择，待独立核对，不按作者或体裁批量继承。",
