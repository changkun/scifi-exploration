  "records": [
    {
      "id": "Q135094142",
      "identity": {
        "title": "Listen, Listen",
        "author": "凱特·威爾海姆"
      },
      "fields": {
        "topics": [
          "主体与意识",
          "知识与认识",
          "技术与责任"
        ],
        "issue": "仅法译集具名成员《Un bateau, une aiguille et un peu d’espoir》：保险公司请退役警官和心理学家调查有自杀倾向、购买高额寿险的工程师，发现一名非人类女性能间歇控制他人的身体。救助判断同时面对身体控制与证据不明，风险管理机构不能把人的异常行为直接等同自主选择。",
        "issue_facets": [
          {
            "label": "身体控制与同意",
            "question": "他人的身体被间歇控制时，怎样区分当事人的意愿与外部操纵？",
            "basis": "本集评论第3具名成员写非人类女性可远距离、间歇控制他人身体；只采用该设定，不核具体控制原理。"
          },
          {
            "label": "保险调查与异常证据",
            "question": "以保险风险为出发点的调查，怎样判断表面自杀意愿背后的主体和原因？",
            "basis": "同一成员段明确保险公司委托退役警官及心理学家调查高额寿险工程师，发现他在酒店受另一住客控制；不把其他篇目或整集视作同一调查。"
          }
        ]
      },
      "field_notes": {
        "topics": "依本身份确切有限材料人工选择，待独立核对，不按作者或体裁批量继承。",
        "issue": "仅source_evidence所列准确评论/版本范围；解释未独立核验，原作全文未读。",
        "issue_facets": "两项原创解释以具体所述前提为依据；不把评论者推测或政治评价提升为已证事实。"
      },
