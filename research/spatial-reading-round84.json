    {
      "id": "Q74632358",
      "identity": {
        "title": "Dune 7: Cartea Brundurilor",
        "author": "Sebastian A. Corn"
      },
      "fields": {
        "spatial_primary": "earth",
        "spatial_secondary": [],
        "spatial_rationale": "明确本书二手概述以冰封地球的地下城市与隔离legions为舞台；轨道无人战斗是背景，不据系列名扩至整个Dune宇宙。"
      },
      "field_notes": {
        "spatial_primary": "仅下列准确同作材料明确的舞台，待独立核对。",
        "spatial_secondary": "未声明的更大空间尺度不推断。",
        "spatial_rationale": "实际返回的作者资料页引用与本书明确对应的英文概述：冰封地球、地下城市、vortex植入网络与隔离legions；引用的原站未另外打开，不冒称原作或直接作者剧情核对。；另一书的出版社作者栏仅确认Corn用Patrick Herbert名出版此书及Dune关系边界，不支持本书剧情。"
      },
      "verification_status": "knowledge_added_unverified",
      "sources": [
